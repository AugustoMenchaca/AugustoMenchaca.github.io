{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:8777/wireframes/lp-final.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "emulatedFormFactor": "mobile",
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:performance": ["warn", { "minScore": 0.9 }],

        "color-contrast": ["error", { "minScore": 1 }],
        "html-has-lang": ["error", { "minScore": 1 }],
        "image-alt": ["error", { "minScore": 1 }],
        "button-name": ["error", { "minScore": 1 }],
        "link-name": ["error", { "minScore": 1 }],
        "heading-order": ["error", { "minScore": 1 }],
        "meta-viewport": ["error", { "minScore": 1 }],

        "total-byte-weight": ["error", { "maxNumericValue": 2500000 }],
        "unused-css-rules": ["warn", { "maxLength": 2 }],
        "uses-responsive-images": ["warn", { "minScore": 0.8 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
